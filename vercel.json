{
  "version": 2,
  "builds": [
    {
      "src": "Dockerfile",
      "use": "@vercel/docker"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "env": {
    "MYSQL_HOST": "@mysql_host",
    "MYSQL_DATABASE": "@mysql_database", 
    "MYSQL_USER": "@mysql_user",
    "MYSQL_PASSWORD": "@mysql_password"
  },
  "github": {
    "repo": "paul6244/security-management-system-"
  }
}
